      "source_sha256": "6c9f419d0a0811d0f4be7a2ac18c380fb50c8896c02a71d0407f3b51c99748a5",
      "source_expression": "\\begin{equation}\nC=\\begin{pmatrix}\n0&1&1&1&1&1\\\\\n1&0&-1&1&-1&1\\\\\n1&-1&0&-1&1&1\\\\\n1&1&-1&0&1&-1\\\\\n1&-1&1&1&0&-1\\\\\n1&1&1&-1&-1&0\n\\end{pmatrix}.\n\\end{equation}"
    }
  ],
  "statements": [
    {
      "original_number": "3.1",
      "type": "definition",
      "source_file": "sections/01_carrier.tex",
      "output_file": "statements/S3_1.tex",
      "source_sha256": "12afd1ae097a050c0c832730d034241fae11e15fd93947f9234e0bc9f28e4ca0",
      "source_expression": "\\begin{definition}[Thalion]\nA Thalion is a finite structured relational transducer whose local carrier is $G_{60}$, together with only those quotient, deck, transport, closure, history, and readout structures that have been explicitly supplied or derived.\n\\end{definition}"
    },
    {
      "original_number": "4.1",
      "type": "definition",
      "source_file": "sections/02_ontology.tex",
      "output_file": "statements/S4_1.tex",
      "source_sha256": "f07c46a5a8b3cb5b901a3bf689aed80f27c84dae76c657f9163f421ed49e96ed",
      "source_expression": "\\begin{definition}[Relation]\nA relation is a locally available adjacency between distinguishable states or transducers through which an admissible event could occur.\n\\end{definition}"
    },
    {
      "original_number": "5.1",
      "type": "definition",
      "source_file": "sections/02_ontology.tex",
      "output_file": "statements/S5_1.tex",
      "source_sha256": "7023392f6b26811d8fbc8ea7e12ad930e95da41e010677082fbdd7ad122f08a2",
      "source_expression": "\\begin{definition}[Continuation]\nA continuation is a lawful possible next relation available from the present relational and registration context.\n\\end{definition}"
    },
    {
      "original_number": "6.1",
      "type": "definition",
      "source_file": "sections/02_ontology.tex",
      "output_file": "statements/S6_1.tex",
      "source_sha256": "d1a59be28dfcdbcd23e166936317738ca900b8a0229b66e201674206afe45cbd",
      "source_expression": "\\begin{definition}[Informative action]\nInformative action is an admissible realized continuation that creates or changes a registered relational distinction.\n\\end{definition}"
    },
    {
      "original_number": "7.1",
      "type": "definition",
      "source_file": "sections/02_ontology.tex",
      "output_file": "statements/S7_1.tex",
      "source_sha256": "727564196d62fa4d95f920a162697d7d82b00bc8195d3e32d714974d0fe8ef2a",
      "source_expression": "\\begin{definition}[Admissible transduction]\nAn admissible transduction is a local transformation of a complete incoming relational state that satisfies the declared native constraints and preserves the information required for a reversible admissible handoff.\n\\end{definition}"
    },
    {
      "original_number": "7.2",
      "type": "example",
      "source_file": "sections/02_ontology.tex",
      "output_file": "statements/S7_2.tex",
      "source_sha256": "11653046ced86137c62608bda461f8221b1b23dc04198f749cfa10d365c0890f",
      "source_expression": "\\begin{example}[Propagation with a nontrivial receipt]\nFor $u,v\\in\\F_2$, let $p=u+v$ and $r=v$. Then\n\\[\n\\mathsf T(u,v)=(u+v,v),\\qquad \\mathsf R(p,r)=(p+r,r).\n\\]\nThe propagated bit alone cannot distinguish $(0,0)$ from $(1,1)$, but the receipt restores the distinction. No information has been copied: two input bits have been reorganized into two output bits.\n\\end{example}"
    },
    {
      "original_number": "10.1",
      "type": "definition",
      "source_file": "sections/02_ontology.tex",
      "output_file": "statements/S10_1.tex",
      "source_sha256": "bf1d02118bd94fe4fe5d5e573c453b217a57a966d339fa653f50f520cb34e72c",
      "source_expression": "\\begin{definition}[QR propagation event]\nA QR event, in the propagation architecture studied here, is one completed, receipted, admissible relational handoff: a local transduction followed by an admitted adjacent transmission, with the information required to reconstruct the complete handoff retained.\n\\end{definition}"
    },
    {
      "original_number": "11.1",
      "type": "proposition",
      "source_file": "sections/03_information_history_time.tex",
      "output_file": "statements/S11_1.tex",
      "source_sha256": "c5fd2364950e5aa4554d0ed84340e0e8bb5be8825becac62d971a2d2d1f88c54",
      "source_expression": "\\begin{proposition}[Classical information preservation]\nFor a map $\\mathsf T:X\\to Y$, a reconstruction map $\\mathsf R:\\im\\mathsf T\\to X$ satisfying $\\mathsf R\\mathsf T=\\id_X$ exists if and only if $\\mathsf T$ is injective.\n\\end{proposition}\n\\begin{proof}\nIf $\\mathsf T(x_1)=\\mathsf T(x_2)$, applying $\\mathsf R$ gives $x_1=x_2$. Conversely, if $\\mathsf T$ is injective, each point of its image has exactly one preimage; assigning that preimage defines $\\mathsf R$.\n\\end{proof}"
    },
    {
      "original_number": "11.2",
      "type": "proposition",
      "source_file": "sections/03_information_history_time.tex",
      "output_file": "statements/S11_2.tex",
      "source_sha256": "706edeae1d622d56cf30778d3be47b6e2f59325de044f32beb916d31eab073a4",
      "source_expression": "\\begin{proposition}[Compositional preservation]\nA composition of admitted injective event maps is injective, provided the domains match and later maps include rather than silently discard the retained outputs required by earlier maps.\n\\end{proposition}\n\\begin{proof}\nFor two events with reconstructors $\\mathsf R_1,\\mathsf R_2$, the reverse-order composition $\\mathsf R_1\\circ\\mathsf R_2$ reconstructs $\\mathsf T_2\\circ\\mathsf T_1$. Induction proves the claim for a finite history. The domain qualification ensures that the second map acts on the complete intermediate state.\n\\end{proof}"
    },
    {
      "original_number": "11.3",
      "type": "proposition",
      "source_file": "sections/03_information_history_time.tex",
      "output_file": "statements/S11_3.tex",
      "source_sha256": "a4894bd80df6f7b0a2094bda0216e89b970d1c858b48d83e9e4443a185f9cf83",
      "source_expression": "\\begin{proposition}[Receipt-capacity bound]\nA completing receipt alphabet exists with size $k$ if and only if\n\\input{equations/E14}\n\\end{proposition}\n\\begin{proof}\nWithin one propagated fiber, receipt labels must all differ, proving necessity. Conversely, enumerate each fiber independently using labels $1,\\ldots,k$. The pair of its propagated value and its fiber label identifies every input, proving sufficiency.\n\\end{proof}"
    },
    {
      "original_number": "15.1",
      "type": "proposition",
      "source_file": "sections/03_information_history_time.tex",
      "output_file": "statements/S15_1.tex",
      "source_sha256": "70294caba8551f9735539c72ede9a3803cd12a43a6fd703e86668b90d7f8dba1",
      "source_expression": "\\begin{proposition}[Predictive quotient]\nIf future responses compose consistently under prefixing, predictive equivalence is an equivalence relation and is preserved by appending the same admitted event.\n\\end{proposition}\n\\begin{proof}\nReflexivity, symmetry, and transitivity follow from equality of languages and response functions. If $h_1\\sim_{\\rm pred}h_2$ and $e$ is admitted at both, a future word after $h_i e$ is exactly a word $w$ for which $ew\\in\\mathcal L(h_i)$. Equality of the original languages and responses gives equality for the residual languages and responses.\n\\end{proof}"
    },
    {
      "original_number": "17.1",
      "type": "definition",
      "source_file": "sections/03_information_history_time.tex",
      "output_file": "statements/S17_1.tex",
      "source_sha256": "c7b33e8165124d8a524bb69403deb5b585f79102de59ae018b1d0d51702ea10b",
      "source_expression": "\\begin{definition}[Thalean time]\nOn the admitted closed registered-history domain, Thalean time is the primitive additive oriented winding of the distinguished $G_{30}$-visible registered-history class $r_1$:\n\\input{equations/E24}\n\\end{definition}"
    },
    {
      "original_number": "17.2",
      "type": "proposition",
      "source_file": "sections/03_information_history_time.tex",
      "output_file": "statements/S17_2.tex",
      "source_sha256": "d99be2ddad9a3e44ea5c5df9e97311ef069cc22adb195bf377ea1c26dd7247c2",
      "source_expression": "\\begin{proposition}[Temporal composition]\nFor composable admitted closed histories,\n\\input{equations/E26}\n\\end{proposition}\n\\begin{proof}\nHomology sends concatenation to addition and reversal to negation. Applying the homomorphism $\\varphi_1$ gives both identities.\n\\end{proof}"
    },
    {
      "original_number": "20.1",
      "type": "definition",
      "source_file": "sections/04_propagation.tex",
      "output_file": "statements/S20_1.tex",
      "source_sha256": "21aed09b66862f617550cac3a5f6f21d0a7c8e7fdea61c5d7733bc74eb3760d7",
      "source_expression": "\\begin{definition}[Event-preserving history]\nAn event-preserving history is an admissible composition in which the relational distinction being propagated remains identifiable through every local transduction and carrier handoff, with the complementary information required for reconstruction retained in the complete description.\n\\end{definition}"
    },
    {
      "original_number": "22.1",
      "type": "definition",
      "source_file": "sections/04_propagation.tex",
      "output_file": "statements/S22_1.tex",
      "source_sha256": "6d6f9584dd1d7456f6e810b0b1a394eeb8d7ed10388d95ebb4ca6e558a6e2932",
      "source_expression": "\\begin{definition}[Thalean causal datum]\nThalean $c$ is the maximal rate at which a well-defined relational event can acquire new field address while every transducer locally preserves the information required for reversible admissible handoff. Formally,\n\\input{equations/E29}\nThe native causal accounting normalizer is $\\cth=1$.\n\\end{definition}"
    },
    {
      "original_number": "22.2",
      "type": "proposition",
      "source_file": "sections/04_propagation.tex",
      "output_file": "statements/S22_2.tex",
      "source_sha256": "e8d6dcfa3a29d76666f2d8e7d402137e8f73c3d76aacfe83fb3d916addc67164",
      "source_expression": "\\begin{proposition}[Unit causal bound]\nSuppose every primitive step in an admitted history changes field address by distance at most one. Then every such history of depth $n>0$ satisfies\n\\input{equations/E30}\nIf the domain contains at least one event-preserving adjacent handoff of irreducible depth one, then $\\cth=1$.\n\\end{proposition}\n\\begin{proof}\nLet $v_0,\\ldots,v_n$ be the addresses encountered. The triangle inequality gives\n$d(v_0,v_n)\\leq\\sum_{k=1}^{n}d(v_{k-1},v_k)\\leq n$.\nThe stated one-step handoff has ratio one and supplies the reverse inequality for the supremum.\n\\end{proof}"
    },
    {
      "original_number": "23.1",
      "type": "proposition",
      "source_file": "sections/04_propagation.tex",
      "output_file": "statements/S23_1.tex",
      "source_sha256": "8548b0e8e21b480765882336c55b7e49a461a4414bf0aa7b57d9a52c7254de1c",
      "source_expression": "\\begin{proposition}\nIf the address graph has finite diameter $D$, then for every sequence of histories with event depths tending to infinity,\n\\[\n0\\leq\\frac{d_{\\mathrm{field}}(s(\\gamma_n),t(\\gamma_n))}{|\\gamma_n|_{\\mathrm{event}}}\n\\leq\\frac{D}{|\\gamma_n|_{\\mathrm{event}}}\\longrightarrow0.\n\\]\n\\end{proposition}"
    },
    {
      "original_number": "25.1",
      "type": "proposition",
      "source_file": "sections/05_measure_registration.tex",
      "output_file": "statements/S25_1.tex",
      "source_sha256": "107233f2f55fb12bb574cae2a731c3c0a2878228ee56032613e3bfe197e1aee6",
      "source_expression": "\\begin{proposition}[No new distinction from identical upstream outputs]\nLet two preparations induce the same distribution $p=q$ on an upstream output register. Applying the same downstream stochastic map $K$ yields the same output distribution $Kp=Kq$. More generally, total variation distance cannot increase:\n\\[\n\\|Kp-Kq\\|_1\\leq\\|p-q\\|_1.\n\\]\n\\end{proposition}\n\\begin{proof}\nFor a column-stochastic matrix $K$,\n$\\sum_y|\\sum_xK_{yx}(p_x-q_x)|\\leq\\sum_{y,x}K_{yx}|p_x-q_x|=\\sum_x|p_x-q_x|$.\nEquality of inputs is the zero-distance case.\n\\end{proof}"
    },
    {
      "original_number": "26.1",
      "type": "proposition",
      "source_file": "sections/05_measure_registration.tex",
      "output_file": "statements/S26_1.tex",
      "source_sha256": "f346d7a673a7f0994bd48d116fe6602fdcf21a46a72385a19607fa38fac81e10",
      "source_expression": "\\begin{proposition}[Finite autonomous recurrence]\nA deterministic autonomous machine with a finite complete state space and a fixed finite-valued output map has eventually periodic output. Every limiting symbol frequency therefore exists and is rational.\n\\end{proposition}\n\\begin{proof}\nSome complete state repeats. Determinism repeats the ensuing future, so the trajectory has a finite transient followed by a periodic orbit of length $q$. If a symbol occurs $k$ times in that orbit, its limiting frequency is $k/q$; the transient contributes zero asymptotic density.\n\\end{proof}"
    },
    {
      "original_number": "28.1",
      "type": "proposition",
      "source_file": "sections/06_quantum.tex",
      "output_file": "statements/S28_1.tex",
      "source_sha256": "aad3055291164f8232d9bf6107ecfb4026a83073f0fa9679eaa8f351ec4998d4",
      "source_expression": "\\begin{proposition}[Undisturbed arbitrary payloads have no state-dependent pure receipt]\nSuppose a common isometry obeys\n\\[\nV|\\psi\\rangle=U|\\psi\\rangle\\otimes|r_\\psi\\rangle\n\\]\nfor every normalized input, where $U$ is fixed and isometric. Then the receipt cannot distinguish arbitrary input states.\n\\end{proposition}\n\\begin{proof}\nInner-product preservation gives\n$\\langle\\phi|\\psi\\rangle=\\langle\\phi|\\psi\\rangle\\langle r_\\phi|r_\\psi\\rangle$.\nFor nonorthogonal inputs, $\\langle r_\\phi|r_\\psi\\rangle=1$. Orthogonal states can each be linked to a common nonorthogonal superposition, giving the same conclusion throughout the input space.\n\\end{proof}"
    },
    {
      "original_number": "32.1",
      "type": "hypothesis",
      "source_file": "sections/07_geometry.tex",
      "output_file": "statements/S32_1.tex",
      "source_sha256": "520711bd84c6173b26be938808acdff162aff8efd87c34b624ba281a607cd5fa",
      "source_expression": "\\begin{hypothesis}[History-conditioned accessibility]\nIn an appropriate transducer field, some retained relational distinctions affect subsequent admissible handoffs. After coarse-graining, this dependence admits a geometric description of causal accessibility.\n\\end{hypothesis}"
    },
    {
      "original_number": "40.1",
      "type": "definition",
      "source_file": "sections/09_collective.tex",
      "output_file": "statements/S40_1.tex",
      "source_sha256": "1e2a94c5f7bb40a4af8d024edc23d939d08abab78a469fb9c5ce5662b95cf8f7",
      "source_expression": "\\begin{definition}[Balanced release]\nBalanced release is efficient local conversion of internal excitation into admissible propagating field modes, with the complementary relational information required for the event preserved in the complete accounting.\n\\end{definition}"
    }
  ]
}
