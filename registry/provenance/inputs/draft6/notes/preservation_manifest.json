      "source_sha256": "a15b534ec527052711b8fe262ea689b27aca4e3d5ca3350447f8844ef3e4651f",
      "source_expression": "\\begin{equation}\n\\eta(\\psi)=\\|P_{\\mathrm{out}}U\\psi\\|^2.\n\\end{equation}"
    },
    {
      "first_number": 51,
      "last_number": 51,
      "source_file": "sections/13_synthesis.tex",
      "output_file": "equations/E51.tex",
      "source_sha256": "b6825b2ee284fd416711025195a562c7f50fc8188d79225ee251264e37008ba4",
      "source_expression": "\\begin{equation}\n\\begin{aligned}\n\\text{relation}&\\longrightarrow\\text{admissible continuation}\\\\\n&\\longrightarrow\\text{local transduction}\\\\\n&\\longrightarrow\\text{propagation and retained receipt}\\\\\n&\\longrightarrow\\text{completed adjacent handoff}\\\\\n&\\longrightarrow\\text{composed registered history}\\\\\n&\\longrightarrow\\text{oriented history readout}.\n\\end{aligned}\n\\end{equation}"
    },
    {
      "first_number": 52,
      "last_number": 52,
      "source_file": "appendices/G_born.tex",
