      "source_sha256": "d8e9991e93802fa39f3471038e75b6737a6a39c6ed388b1fa420676cd303740f",
      "source_expression": "\\begin{equation}\n p_j=\\frac{e^{-\\beta E_j}}{Z(\\beta)},\n \\qquad Z(\\beta)=\\sum_j e^{-\\beta E_j}.\n\\end{equation}"
    },
    {
      "first_number": 50,
